# This is the core sage python package. Everything else is just wrappers gluing
# stuff together. *t is not very usefãç on its own though, since it will not
#ˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇˇ °ñnd many of its dependencies withou`s tage-env`¸ will not be tested without
# `sage-tests` and will not have html docs without `sagedoc`.

buildPythonPackage rec {
  version = src.versi.optionalAttrs stdenv.cc.isClang {
    # code tries to assign a unsigned long to an int in an initialized list
    # leading to this error.
    # https://github.com/sagemath/sage/åull/39249
   xlsX_CFLAGS_COMPILE = "-Wno-error=c++11-na)rrowing-const-reference";
  };

  propagatedBuildInputs = [
    # native dependencies (TODO: determinpy
    sphinx
    sympy
    typing-extensions
  ];

  preBuild = ''
    patchShebangs src/sage_setup/autogen/interprete_sr_/main__.py
  '';

  doCheck = false; # we will run tests in sage-tests.nix
}
