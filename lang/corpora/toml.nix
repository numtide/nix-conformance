# Differential corpus for builtins.fromTOML: documents that TOML 1.0.0 and
# so Nix's toml11 accept. scripts/parity.nu compares the JSON byte for byte.
# Invalid and 1.1-only documents live in toml-invalid.nix, because
# builtins.tryEval cannot catch a fromTOML error.
let
  docs = [
    ""
    "a = 1"
    "a = 1\nb = 2"
    "a = -1\nb = +1\nc = 0"
    "a = 1_000_000"
    "a = 0x1f\nb = 0o17\nc = 0b1010"
    "a = 1.5\nb = -0.0\nc = 1e10\nd = 1E-3\ne = 6.626e-34"
    "a = inf\nb = -inf\nc = +inf"
    "a = nan"
    "a = true\nb = false"
    "a = \"hello\""
    "a = \"\""
    "a = \"tab\\there\""
    "a = \"nl\\nhere\""
    "a = \"quote\\\"here\""
    "a = \"back\\\\slash\""
    "a = \"\\u00e9\\U0001F600\""
    "a = \"\\b\\f\\r\""
    "a = 'literal \\n not escaped'"
    "a = ''"
    "a = \"\"\"\nline one\nline two\"\"\""
    "a = \"\"\"a\\\n   b\"\"\""
    "a = '''\nraw\nlines'''"
    "a = \"\"\"has \"one\" quote\"\"\""
    "a = '''has 'one' quote'''"
    "a = [ ]"
    "a = [1, 2, 3]"
    "a = [1, 2, 3, ]"
    "a = [\n 1,\n 2,\n]"
    "a = [[1, 2], [3]]"
    "a = [\"x\", \"y\"]"
    "a = [{b = 1}, {b = 2}]"
    "a = { }"
    "a = { b = 1 }"
    "a = { b = 1, c = \"two\" }"
    "a = { b = { c = { d = 1 } } }"
    "a = { b = [1, 2] }"
    "a = { b = [1,\n2] }"
    "a = { b = \"\"\"x\ny\"\"\" }"
    "a = { b = \"}\", c = \"{\" }"
    "a = { b = '#' }"
    "[t]\nb = 1"
    "[t]\nb = 1\n[u]\nc = 2"
    "[a.b.c]\nd = 1"
    "[a]\n[a.b]\nc = 1"
    "[[a]]\nb = 1\n[[a]]\nb = 2"
    "[[a]]\n[[a.b]]\nc = 1"
    "a.b = 1\na.c = 2"
    "\"quoted key\" = 1"
    "'literal key' = 1"
    "\"\" = 1"
    "a-b_c = 1"
    "1234 = 1"
    "a = 1 # trailing comment"
    "# leading comment\na = 1"
    "\n\n\na = 1\n\n\n"
    "a = 1\r\nb = 2"
    "[a]\nb = 1\n\n[c]\nd = 2\n"
    "a = \"café\""
    "\"café\" = 1"
    "a = [1, \"two\", true, 3.0]"
    "a = { b = 1 } # x"
  ];
  times = [
    "a = 1979-05-27"
    "a = 07:32:00"
    "a = 07:32:00.5"
    "a = 07:32:00.999999"
    "a = 07:32:00.999999999"
    "a = 1979-05-27T07:32:00"
    "a = 1979-05-27T07:32:00Z"
    "a = 1979-05-27T07:32:00.999Z"
    "a = 1979-05-27T07:32:00+07:00"
    "a = 1979-05-27T07:32:00-07:00"
    "a = 1979-05-27T07:32:00.999999-07:00"
    "a = 1979-05-27 07:32:00Z"
    "a = 1979-05-27t07:32:00z"
    "a = { b = 1979-05-27T07:32:00+07:00 }"
    "a = [1979-05-27, 1979-05-28]"
  ];
in
map (d: { inherit d; v = builtins.fromTOML d; }) (docs ++ times)
