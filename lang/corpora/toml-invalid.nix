# TOML documents Nix's toml11 (spec 1.0.0) rejects: the TOML 1.1 syntax the
# `toml` crate accepts on its own, plus plain syntax errors. fromTOML errors
# are not catchable with builtins.tryEval, so scripts/parity.nu runs one
# process per entry and compares the exit status.
[
  # --- TOML 1.1 only
  "a = { b = 1,\n c = 2 }"
  "a = {\n b = 1 }"
  "a = { b = 1\n}"
  "a = { b = 1, }"
  "a = { b = 1 , }"
  "a = { b = 1, c = { d = 2, } }"
  "a = { # comment\n b = 1 }"
  "a = { b = [1, 2], }"
  "a = \"\\e\""
  "a = \"x\\ey\""
  "a = \"\"\"\\e\"\"\""
  "a = \"\"\"\n\\e\"\"\""
  "a = \"\\x41\""
  "a = \"\\x41\\x42\""
  "a = \"\"\"\\x41\"\"\""
  "a = 07:32"
  "a = 1979-05-27T07:32"
  "a = 1979-05-27T07:32Z"
  "a = 1979-05-27T07:32+07:00"
  "a = { b = 07:32 }"
  "a = [07:32]"
  "kéy = 1"
  # --- invalid under both
  "a ="
  "a = ="
  "= 1"
  "a = 1\na = 2"
  "[a]\n[a]"
  "a = { b = 1"
  "a = [1, 2"
  "a = \"unterminated"
  "a = 'unterminated"
  "a = \"\"\"unterminated"
  "a = 01"
  "a = 1__0"
  "a = 1979-13-01"
  "a = 25:00:00"
  "a = \"\\q\""
  "a = \"\\u00\""
  "a = tru"
  "[a\nb = 1"
  "a b = 1"
  "a = 1 b = 2"
  "a = 1\rb = 2"
  "a = \"raw\nnewline\""
  "[]\na = 1"
  "a.b = 1\na.b.c = 2"
]
